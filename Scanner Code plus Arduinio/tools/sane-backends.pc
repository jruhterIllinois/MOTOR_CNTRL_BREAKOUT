prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
libs= -ldl  -lm -ltiff -ljpeg       -lusb-1.0   

Name: SANE Backends
Description: Backends for SANE, the universal scanner interface
Version: 1.2.1
Requires:
Libs: -L${libdir} -lsane
Libs.private: ${libs}
Cflags: -I${includedir}
